{
	"name": "CV Portfolio",
	"dockerComposeFile": [
		"../docker-compose.yml"
	],
	"initializeCommand": "docker compose -f docker-compose.yml -f docker-compose.build.yml build",
	"service": "app",
	"workspaceFolder": "/var/www/html",
	"forwardPorts": [
		5173,
		8000
	],
	"portsAttributes": {
		"*": {
			"onAutoForward": "ignore"
		},
		"5173": {
			"label": "Vite Dev Server",
			"onAutoForward": "notify"
		},
		"8000": {
			"label": "Laravel",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"bmewburn.vscode-intelephense-client",
				"eamodio.gitlens"
			],
			"settings": {
				"remote.autoForwardPorts": false
			}
		}
	}
}